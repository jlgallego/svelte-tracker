@tailwind base;
@tailwind components;
@tailwind utilities;

:root {
  /* Altura mínima para que el contenedor ocupe pantalla completa */
  --bottom-panel-min-height: 100px; 
  --bottom-panel-max-height: 80vh;
  --button-bar-bg: rgba(255 255 255 / 0.9);
}

/* Reset básico */
body, html {
  margin: 0;
  padding: 0;
  height: 100vh;
  width: 100vw;
  overflow: hidden; /* evitar scroll general, lo gestionamos en bottom panel */
}

.app-container {
  height: 100vh;
  width: 100vw;
  display: flex;
  flex-direction: column;
  background-color: #f0f0f0; /* o transparente si quieres */
}

.map-section {
  flex-grow: 1;
  position: relative;
  min-height: 0; /* para que flex shrinking funcione correctamente */
  display: flex;  /* si Map usa flex hijos */
}

.map-container {
  flex-grow: 1;
  position: relative;
  /* Importante para que el mapa ocupe todo este contenedor */
}

.button-bar {
  top: 12px;
  left: 12px;
  z-index: 10;
  display: flex;
  gap: 8px;
  padding: 6px 12px;
  background: var(--button-bar-bg);
  border-radius: 6px;
  box-shadow: 0 2px 6px rgba(0,0,0,0.25);
}

.bottom-panel {
  height: var(--bottom-panel-default-height, 200px);
  max-height: var(--bottom-panel-max-height);
  min-height: var(--bottom-panel-min-height);
  background: white;
  border-top: 1px solid #ccc;
  overflow-y: auto; /* Scroll independiente */
  -webkit-overflow-scrolling: touch; /* mejor scroll en iOS */
  user-select: text;
}

.resize-handle {
  position: absolute;
  height: 6px;
  width: 100%;
  cursor: ns-resize;
  background-color: #ddd;
  border-bottom: 1px solid #bbb;
  z-index: 15;
}

/* Estilos para la lista de ficheros dentro de bottom-panel */
ul.file-list {
  margin: 0;
  padding: 8px 12px;
  list-style-type: none;
  max-height: 100%;
  overflow-y: auto;
}

/* Botón flotante con z-index y estilo claro */
button {
  cursor: pointer;
  border: none;
  background-color: #3182ce; /* azul Tailwind */
  color: white;
  padding: 0.5rem 1rem;
  border-radius: 0.375rem;
  font-weight: 600;
  transition: background-color 0.2s;
}

button:hover {
  background-color: #2c5282;
}

/* Clase seleccionada para botones */
.selected {
  font-weight: bold;
  color: #2b6cb0;
  text-decoration: underline;
}